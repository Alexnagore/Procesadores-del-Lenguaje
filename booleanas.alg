algoritmo sumacomb;
ent b_a: booleano;
{Prec: n= N AND m = M AND M >= N >0}
var
b_b, b_c: booleano;
a, b: entero;
fvar;
b_a:=b_b<>b_c;
b_a:=a<=b;
b_a:=a>=b;
b_a:=a<b;
b_a:=a>b;
b_a:=a=b;
b_a:=(a=b);
b_a:=no b_b;
b_a:=b_b y b_c;
b_a:=b_b o b_c
{Post: n =N AND suma = SUMATORIO(i=1..N)(M sobre i)}
falgoritmo.